<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>BannedApiAnalyzers.Unity</AssemblyName>
    <PackageId>BannedApiAnalyzers.Unity</PackageId>
    <Version>1.0.2</Version>
    <MicrosoftCodeAnalysisVersion>$(MicrosoftCodeAnalysisVersionForBannedApiAnalyzers)</MicrosoftCodeAnalysisVersion>
    <!-- Prevents the package from being added as a compile-time reference -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Analyzers are loaded by the host; their transitive deps (Microsoft.CodeAnalysis.*) are already present -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Baseline version is passed by CI (-p:PackageValidationBaselineVersion=<latest on nuget.org>);
         local builds run structure checks only, without API-compat baseline. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Roslyn analyzer DLLs must go to analyzers/dotnet/cs/ (no TFM subfolder).
         BuildOutputTargetFolder would add a netstandard2.0/ subfolder, so we use IncludeBuildOutput=false
         and include both DLLs manually via None items below. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <Authors>Koji Hasegawa</Authors>
    <Copyright>(c) 2026 Koji Hasegawa</Copyright>
    <Description>Unity-focused fork of Microsoft.CodeAnalysis.BannedApiAnalyzers that uses Unity additional files instead of BannedSymbols.txt — no .csproj edits required.</Description>
    <PackageProjectUrl>https://github.com/nowsprinting/BannedApiAnalyzers.Unity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nowsprinting/BannedApiAnalyzers.Unity.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Roslyn Analyzer Unity BannedApi CodeAnalysis RoslynAnalyzer RS0030</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- RoslynDiagnosticIds.cs was originally from ..\..\Roslyn.Diagnostics.Analyzers\Core\ (outside repo).
         It is now vendored directly in Core/ and picked up by the SDK's default Compile glob. -->
    <InternalsVisibleTo Include="BannedApiAnalyzers.Unity.CSharp" />
    <!-- VisualBasic project is excluded from this Unity-targeted standalone build. -->
    <InternalsVisibleTo Include="BannedApiAnalyzers.Unity.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\License.txt" Pack="true" PackagePath="/" />
    <None Include="..\BannedApiAnalyzers.Unity.Help.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both analyzer DLLs go directly under analyzers/dotnet/cs/ (no TFM subfolder) -->
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
    <None Include="..\CSharp\bin\$(Configuration)\netstandard2.0\BannedApiAnalyzers.Unity.CSharp.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
  <!-- Original: ..\..\Utilities\Compiler\Analyzer.Utilities.projitems (sibling in roslyn-analyzers monorepo).
       Vendored under Utilities/Compiler/ for standalone build. -->
  <Import Project="..\Utilities\Compiler\Analyzer.Utilities.projitems" Label="Shared" />
</Project>
